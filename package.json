{
  "name": "@robwelan/simle-library",
  "version": "1.0.17",
  "description": "Standard for Multilingual Technical Education Powered by Rust/Wasm",
  "type": "module",
  "main": "web/index.html",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir wasm",
    "dev": "npx serve .",
    "predeploy": "npm run build:wasm",
    "deploy": "gh-pages -d web -a -add wasm -add books -add shared_assets",
    "clean:docs": "rm -rf docs && git add docs && git commit -m 'remove legacy docs folder'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robwelan/simle-library.git"
  },
  "keywords": [
    "wasm",
    "rust",
    "education",
    "multilingual",
    "simle"
  ],
  "author": "robwelan",
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
